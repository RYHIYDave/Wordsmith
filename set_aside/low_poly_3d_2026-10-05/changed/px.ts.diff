+/**
+ * The light a fire throws on what is round it: a pool of its colour, `rx` to either side and `ry`
+ * up and down (a pool on the floor is seen from above, so about half as deep as it is wide).
+ * Added to the picture, so it warms the stone it falls on and whoever stands in it.
+ */
+export function drawPool(g: CanvasRenderingContext2D, x: number, y: number, rx: number, ry: number, color: string, a: number): void {
+  const before = g.globalCompositeOperation;
+  g.globalCompositeOperation = 'lighter';
+  g.globalAlpha = Math.max(0, Math.min(1, a));
+  g.drawImage(glowOf(color), x - rx, y - ry, rx * 2, ry * 2);
+  g.globalAlpha = 1;
+  g.globalCompositeOperation = before;
+}
 
